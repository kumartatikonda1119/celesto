# SafeRepo configuration.
# Copy to .env for local development. Never commit the real .env.
# Every variable the api process (and the host scripts) reads is listed here.

# --- Celesto execution layer ---------------------------------------------
# local | cloud
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
# firecracker | qemu (backend selector passed through to the SDK)
CELESTO_BACKEND=firecracker
# scratch | coding-agent
CELESTO_TEMPLATE=scratch
# micro | standard | large (used for the cost estimate)
CELESTO_SIZE=micro
# Optional Named sandbox size accepted by the cloud create request. Leave
# empty to use the cloud default; the SDK's public constructor does not
# forward size_id, so the adapter sets it only when this is provided.
CELESTO_SIZE_ID=

# --- LLM (OpenAI-compatible) ---------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name

# --- Control plane --------------------------------------------------------
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080
API_BASE_URL=http://localhost:8080

# --- Agent budgets --------------------------------------------------------
SAFEREPO_COMMAND_TIMEOUT_S=120
SAFEREPO_MAX_STEPS=15
SAFEREPO_RUN_BUDGET_S=720
SAFEREPO_BOOT_TIMEOUT_S=180

# --- Paths (container defaults; scripts override for host runs) ----------
SAFEREPO_REPORT_DIR=/app/reports
SAFEREPO_LOG_DIR=/app/logs

# --- Safety / containment -------------------------------------------------
# open | off. Cloud network policy is fixed at create time; there is no
# per-domain allow-list in the cloud API, so containment is enforced by the
# command policy (see README).
SAFEREPO_NETWORK_MODE=open
# Hosts the agent is allowed to reach (clone + package installs only).
SAFEREPO_ALLOWED_HOSTS=github.com,codeload.github.com,pypi.org,files.pythonhosted.org
# Synthetic canary used by the containment test. Never a real credential.
SAFEREPO_CANARY=canary_do_not_exfiltrate_4f1c
# Fault injection switch for the documented step-7 failure simulation.
SAFEREPO_FAULT=
